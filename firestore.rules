rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff allowed to open PAHRAVA data. Add an email here (lower case) and
    // create the account in Firebase Authentication to give someone access.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in [
          'rathidevansh09@gmail.com'
        ];
    }
    match /pahrava/{docId} {
      allow read, write: if isStaff();
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
