rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Login is currently OFF (VITE_REQUIRE_LOGIN=false): the app connects with
    // an anonymous Firebase identity, so anyone with the link can read and write.
    //
    // To require login again: set VITE_REQUIRE_LOGIN=true in .env.production and
    // replace the condition below with the staff list:
    //   request.auth != null && request.auth.token.email in ['rathidevansh09@gmail.com']
    function isStaff() {
      return request.auth != null;
    }
    match /pahrava/{docId} {
      allow read, write: if isStaff();
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
